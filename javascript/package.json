{
  "name": "apihorseracing",
  "version": "1.0.0",
  "description": "Official JavaScript client for the Horse Racing API: results, form, starting prices and price movement back to 2017.",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "horse racing",
    "racing",
    "api",
    "results",
    "form",
    "starting prices",
    "sports data"
  ],
  "homepage": "https://apihorseracing.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/APIHorseRacing/horse-racing-api-sdk.git",
    "directory": "javascript"
  },
  "license": "MIT",
  "dependencies": {},
  "bugs": {
    "url": "https://github.com/APIHorseRacing/horse-racing-api-sdk/issues"
  }
}
